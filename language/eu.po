#: Module.php:67 Module.php:68 Module.php:111
msgid "Copy"
msgstr "Kopiatu"

#: view/common/copy-resources/copy-confirm-item_sets.phtml:2
msgid "Copy item set"
msgstr "Kopiatu elementu multzoa"

#: view/common/copy-resources/copy-confirm-item_sets.phtml:3
msgid "Are you sure you would like to copy this item set?"
msgstr "Ziur zaude elementu multzo hau kopiatu nahi duzula?"

#: view/common/copy-resources/copy-confirm-items.phtml:2
msgid "Copy item"
msgstr "Kopiatu elementua"

#: view/common/copy-resources/copy-confirm-items.phtml:3
msgid ""
"This process will not copy media. If you must copy media, you can use the <a"
" href=\"https://omeka.org/s/modules/Osii/\" target=\"_blank\">Omeka S Item "
"Importer</a> module."
msgstr ""
"Prozesu honek ez du multimedia kopiatuko. Multimedia kopiatu nahi baduzu, <a"
" href=\"https://omeka.org/s/modules/Osii/\" target=\"_blank\">Omeka S "
"Elementu Inportazio</a> modulua erabili dezakezu."

#: view/common/copy-resources/copy-confirm-items.phtml:4
msgid "Are you sure you would like to copy this item?"
msgstr "Ziur zaude elementu hau kopiatu nahi duzula?"

#: view/common/copy-resources/copy-confirm-site_pages.phtml:2
msgid "Copy page"
msgstr "Kopiatu orrialdea"

#: view/common/copy-resources/copy-confirm-site_pages.phtml:3
msgid "Are you sure you would like to copy this page?"
msgstr "Ziur zaude orrialde hau kopiatu nahi duzula?"

#: view/common/copy-resources/copy-confirm-sites.phtml:2
msgid "Copy site"
msgstr "Kopiatu ataria"

#: view/common/copy-resources/copy-confirm-sites.phtml:3
msgid ""
"Page blocks and navigation links added by modules may carry over as invalid "
"placeholders. You will have to replace them or reorganize your pages and "
"navigation. Other data added by modules may not carry over at all."
msgstr ""
"Moduluek gehitutako orrialde bloke eta nabigazio estekak leku-marka "
"desegokiak eduki ditzakete. Ordezkatu egin beharko dituzu edo zure orri zein"
" nabigazioa berrantolatu. Moduluek gehitutako beste informazioa baliteke ez "
"ekarri izana."

#: view/common/copy-resources/copy-confirm-sites.phtml:4
msgid "Are you sure you would like to copy this site?"
msgstr "Ziur zaude atari hau kopiatu nahi duzula?"

#: src/Controller/Admin/IndexController.php:69
msgid "Item successfully copied. The copy is below."
msgstr "Elementua ongi kopiatu da. Kopia azpian dago."

#: src/Controller/Admin/IndexController.php:73
msgid "Item set successfully copied. The copy is below."
msgstr "Elementu multzoa ongi kopiatu da. Kopia azpian dago."

#: src/Controller/Admin/IndexController.php:77
msgid "Page successfully copied. The copy is below."
msgstr "Orrialdea ongi kopiatu da. Kopia azpian dago."

#: src/Controller/Admin/IndexController.php:81
msgid "Site successfully copied. The copy is below."
msgstr "Ataria ongi kopiatu da. Kopia azpian dago."

#: src/Controller/Admin/IndexController.php:86
msgid ""
"There was an error during the copy process. If a copy was created, it is "
"likely incomplete. The error message is below. Check your Omeka log for the "
"complete error."
msgstr ""
"Arazo bat egon da kopiatzeko prozesuan. Kopia sortu bada, ziurrenik osatu "
"gabe egongo da. Errore mezuan azpian dago. Begiratu zure Omeka log "
"fitxategia errore osoa ikusteko."

#: src/Form/CopyConfirmForm.php:17
msgid "Same as original"
msgstr "Jatorrizkoaren berdina"

#: src/Form/CopyConfirmForm.php:28
msgid "Confirm copy"
msgstr "Baieztatu kopiatzea"
